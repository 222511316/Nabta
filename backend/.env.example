# Copy to backend/.env and adjust. Every setting is optional; the defaults suit local development.

# Database and photo storage (defaults: backend/storage/nabta.db and backend/storage/photos/)
# NABTA_DATABASE_URL=sqlite:///C:/path/to/nabta.db
# NABTA_STORAGE_DIR=C:/path/to/storage

# Where the React app runs; used to build password-reset links.
# NABTA_FRONTEND_URL=http://localhost:5173

# Sessions and security
# NABTA_SESSION_DAYS=7
# NABTA_COOKIE_SECURE=false        # set true when served over HTTPS
# NABTA_RESET_TOKEN_MINUTES=60
# NABTA_MAX_UPLOAD_MB=10

# Email. Without NABTA_SMTP_HOST, emails (such as reset links) are printed in the backend console.
# NABTA_SMTP_HOST=smtp.gmail.com
# NABTA_SMTP_PORT=587
# NABTA_SMTP_USER=you@example.com
# NABTA_SMTP_PASSWORD=app-password
# NABTA_SMTP_FROM=Nabta <you@example.com>
# NABTA_SMTP_STARTTLS=true
